<Page
    x:Class="LockWizard.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LockWizard"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Padding="24"
            MaxWidth="480">

            <TextBlock
                Text="LockWizard"
                FontSize="32"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"/>

            <TextBlock
                Text="在下方输入你想在锁屏详细状态显示的文字"
                FontSize="14"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                TextAlignment="Center"/>

            <TextBox
                x:Name="StatusTextBox"
                PlaceholderText="在这里输入文字…"
                FontSize="16"
                MaxLength="160"
                TextWrapping="Wrap"
                AcceptsReturn="False"
                Margin="0,8,0,0"/>

            <TextBlock
                x:Name="CharCountText"
                Text="0 / 160"
                FontSize="12"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                HorizontalAlignment="Right"/>

            <Button
                x:Name="ApplyButton"
                Content="应用到锁屏"
                HorizontalAlignment="Stretch"
                Click="ApplyButton_Click"
                Style="{StaticResource AccentButtonStyle}"/>

            <TextBlock
                x:Name="StatusLabel"
                Text=""
                FontSize="13"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

            <Border
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock
                        Text="使用说明"
                        FontWeight="SemiBold"
                        FontSize="13"/>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        TextWrapping="Wrap"
                        Text="1. 点击「应用到锁屏」后，前往系统设置"/>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        TextWrapping="Wrap"
                        Text="2. 设置 → 个性化 → 锁屏界面"/>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        TextWrapping="Wrap"
                        Text="3. 在「详细状态」处选择 LockWizard"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Page>
